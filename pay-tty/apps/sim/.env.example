# The sim's own database; plane never connects to it. `pnpm db:setup`
# creates and migrates it. Tests don't use it: each test file makes its own
# database on local Postgres.
SIM_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sim_dev
PORT=4000
# Shared with plane: the API key authorizes plane's calls here, and a
# different secret signs the callbacks to plane.
SIM_API_KEY=<random secret>
SIM_WEBHOOK_SECRET=<another random secret>
# Plane's endpoint for payout outcomes.
PLANE_CALLBACK_URL=http://localhost:3000/webhooks/payouts
# How long a payout stays pending before its outcome (default 5 seconds).
# SIM_PAYOUT_DELAY=5 seconds
