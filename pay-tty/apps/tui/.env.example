# Plane, which issues each connection's token and holds its business.
PLANE_BASE_URL=http://localhost:3000
# Where the SSH server listens. 0.0.0.0 exposes it beyond this machine.
TUI_HOST=127.0.0.1
TUI_PORT=2222
# The SSH host key, generated on first start. Keep it across restarts, or
# every client sees a changed host key.
TUI_HOST_KEY_PATH=.data/host_key
