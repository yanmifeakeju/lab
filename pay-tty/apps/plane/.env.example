# The same database as packages/core, which owns its schema. The ledger
# service keeps its own database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/plane_dev
PORT=3000
# The ledger service, asked to open each business's payable account.
LEDGER_BASE_URL=http://localhost:8080
# Access-token signing keys: comma-separated <key id>:<base64url secret>, each
# secret at least 32 bytes (`pnpm token:key` makes one). Rotate by adding a
# key, moving PLANE_TOKEN_SIGNING_KEY_ID to it, and removing the old key once
# its tokens have expired (15 minutes).
PLANE_TOKEN_KEYS=local:<base64url secret>
PLANE_TOKEN_SIGNING_KEY_ID=local
