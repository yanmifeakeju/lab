{
  "name": "@pay-tty/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch bin/api.ts",
    "start": "node --env-file-if-exists=.env bin/api.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "./scripts/seed.sh",
    "test": "node --env-file-if-exists=.env --test test/*.test.ts",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@pay-tty/ledger-client": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "effect": "4.0.0-rc.117",
    "pg": "^8.23.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
