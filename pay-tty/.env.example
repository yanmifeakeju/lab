# Every app's settings for local development, in one file. Copy to .env. Each
# app reads only its own prefix (PLANE_, SIM_, TUI_); in its code the names
# drop it, so plane's DATABASE_URL is PLANE_DATABASE_URL here. Tests use none
# of this: each test file makes its own database on local Postgres.
#
# `pnpm db:reset` recreates, migrates and seeds every database below;
# `pnpm db:seed` only seeds.

# The ledger service's database, for those scripts only: the service itself
# reads DATABASE_URL from ledger/.env, so keep the two the same.
LEDGER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledger_poc?sslmode=disable

# Plane (apps/plane, and packages/core's migrations and seeds).
# Its database; the ledger service keeps its own.
PLANE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/plane_dev
PLANE_PORT=3000
# The ledger service, asked to open each business's payable account.
PLANE_LEDGER_URL=http://localhost:8080
# Access-token signing keys: comma-separated <key id>:<base64url secret>, each
# secret at least 32 bytes (`pnpm --filter @pay-tty/plane token:key` makes
# one). Rotate by adding a key, moving PLANE_TOKEN_SIGNING_KEY_ID to it, and
# removing the old key once its tokens have expired (15 minutes).
PLANE_TOKEN_KEYS=local:<base64url secret>
PLANE_TOKEN_SIGNING_KEY_ID=local
# The simulated payout provider: the API key plane's calls carry, and a
# different secret that signs its callbacks to /webhooks/payouts. The sim
# takes the same two below.
PLANE_SIM_URL=http://localhost:4000
PLANE_SIM_API_KEY=<random secret>
PLANE_SIM_WEBHOOK_SECRET=<another random secret>

# The simulated payout provider (apps/sim).
# Its own database; plane never connects to it.
SIM_DATABASE_URL=postgres://postgres:postgres@localhost:5432/sim_dev
SIM_PORT=4000
# Plane's two values; only direnv's dotenv expands these references.
SIM_API_KEY=${PLANE_SIM_API_KEY}
SIM_WEBHOOK_SECRET=${PLANE_SIM_WEBHOOK_SECRET}
# Plane's endpoint for payout outcomes.
SIM_PLANE_CALLBACK_URL=http://localhost:3000/webhooks/payouts
# How long a payout stays pending before its outcome (default 5 seconds).
# SIM_PAYOUT_DELAY=5 seconds

# The SSH TUI (apps/tui).
# Plane, which issues each connection's token and holds its business.
TUI_PLANE_URL=http://localhost:3000
# Where the SSH server listens. 0.0.0.0 exposes it beyond this machine.
TUI_HOST=127.0.0.1
TUI_PORT=2222
# The SSH host key, generated on first start. Keep it across restarts, or
# every client sees a changed host key.
TUI_HOST_KEY_PATH=.data/host_key
# The address customers reach this server at, for the `ssh <token>@host` line
# a merchant shares. The port defaults to TUI_PORT.
TUI_PUBLIC_HOST=localhost
# TUI_PUBLIC_PORT=22
