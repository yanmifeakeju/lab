# Copy to .env at the repository root, beside compose.yaml, or run
# deploy/new-env.sh to write one with fresh secrets.

# Postgres: the superuser, then plane's and the ledger's own roles. Used only
# when the volume is first created; changing them later changes nothing.
POSTGRES_PASSWORD=
PLANE_DB_PASSWORD=
LEDGER_DB_PASSWORD=
# The simulated payout provider's role, created by the setup job on first run.
SIM_DB_PASSWORD=

# The sim's API key authorizes plane's calls to the sim; its webhook secret, a
# different value, signs the sim's callbacks. compose.yaml gives plane the same
# two values.
SIM_API_KEY=
SIM_WEBHOOK_SECRET=

# Access-token signing keys, as in the root .env.example
# (`pnpm --filter @pay-tty/plane token:key` makes a secret).
PLANE_TOKEN_KEYS=prod:<base64url secret>
PLANE_TOKEN_SIGNING_KEY_ID=prod

# The server is a demo: payments become available this long after they
# succeed, and the TUI says so. Remove it, or leave it blank, for real T+1
# settlement.
PLANE_SETTLEMENT_DELAY="5 minutes"

# Where customers reach the TUI, for the `ssh <token>@host` line.
TUI_PUBLIC_HOST=paytty.akeju.me
TUI_PUBLIC_PORT=22
# What docker publishes the TUI on: loopback 2222 by default, "22" on the server.
TUI_PUBLISH=22
