# Copy to .env at the repository root, beside compose.yaml.

# Postgres: the superuser, then plane's and the ledger's own roles. Used only
# when the volume is first created; changing them later changes nothing.
POSTGRES_PASSWORD=
PLANE_DB_PASSWORD=
LEDGER_DB_PASSWORD=

# Access-token signing keys, as in apps/plane/.env.example
# (`pnpm --filter @pay-tty/plane token:key` makes a secret).
PLANE_TOKEN_KEYS=prod:<base64url secret>
PLANE_TOKEN_SIGNING_KEY_ID=prod

# Where customers reach the TUI, for the `ssh <token>@host` line.
TUI_PUBLIC_HOST=paytty.akeju.me
TUI_PUBLIC_PORT=22
# What docker publishes the TUI on: loopback 2222 by default, "22" on the server.
TUI_PUBLISH=22
