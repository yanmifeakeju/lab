{
  "name": "@pay-tty/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./columns": "./src/columns.ts",
    "./pages": "./src/pages.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "test": "node --test --test-global-setup=src/testing.ts test/*.test.ts",
